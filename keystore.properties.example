# 复制为 keystore.properties 并填入你自己的签名信息。
# 不创建该文件也能构建 —— 会自动退回 debug 签名。
#
# Copy this file to keystore.properties and fill in your own signing info.
# The build works without it (falls back to the debug signature).
storeFile=keystore/release.jks
storePassword=changeit
keyAlias=changeit
keyPassword=changeit
